module(
    name = "personal-website",
    version = "0.1.0",
    compatibility_level = 1,
)

# Hugo rules
bazel_dep(name = "build_stack_rules_hugo", version = "0.0.9")

git_override(
    module_name = "build_stack_rules_hugo",
    remote = "https://github.com/tstapler/rules_hugo.git",
    commit = "e201bdbad6dc1d3fd434eb59726b699560b32138",
)

# Other dependencies
bazel_dep(name = "rules_pkg", version = "1.0.1")
bazel_dep(name = "rules_oci", version = "2.2.2")
bazel_dep(name = "rules_python", version = "1.8.1")

# Override rules_foreign_cc to Bazel 9.0.0 compatible version
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

# Override rules_nodejs to Bazel 9.0.0 compatible version
bazel_dep(name = "rules_nodejs", version = "6.7.7")

# Hermetic Node.js + npm packages for the theme's gulp/webpack build (no host Node needed)
bazel_dep(name = "aspect_rules_js", version = "3.6.1")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.20.0")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm_theme",
    pnpm_lock = "//themes/espouse-fomantic:pnpm-lock.yaml",
    data = [
        "//themes/espouse-fomantic:package.json",
        "//themes/espouse-fomantic:pnpm-workspace.yaml",
    ],
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, "npm_theme")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
use_repo(pnpm, "pnpm")

# Override aspect_bazel_lib to Bazel 9.0.0 compatible version
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

# Add rules_playwright for native Bazel Playwright integration
bazel_dep(name = "rules_playwright", version = "0.5.3")

# Add rules_browsers for Playwright browser management
bazel_dep(name = "rules_browsers", version = "0.3.0")

playwright = use_extension("@rules_playwright//playwright:extensions.bzl", "playwright")
playwright.repo(
    name = "playwright",
    playwright_version = "1.50.0",
)
use_repo(playwright, "playwright")

# Core Bazel dependencies
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")

# Python toolchain
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.11")

# Configure uv as dependency manager (dev tool)
# Use extension for pip repositories (rules_python 1.8.1)
pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

# Use lock file for Python dependencies
pip.parse(
    hub_name = "personal_website_py_deps",
    python_version = "3.11",
    requirements_lock = "//:requirements_lock.txt",
)

use_repo(pip, "personal_website_py_deps")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")

# Declare external images you need to pull, for example:
oci.pull(
    name = "chainguard_nginx",
    digest = "sha256:50b986b188c26457d060c9e16665b51d2e5e252019ba4e921cb990c71cd24802",
    image = "cgr.dev/chainguard/nginx",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
)

# For each oci.pull call, repeat the "name" here to expose them as dependencies.
use_repo(oci, "chainguard_nginx", "chainguard_nginx_linux_amd64", "chainguard_nginx_linux_arm64")
